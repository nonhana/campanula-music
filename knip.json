{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "entry": [
    "src/lib/components/notice/use-toast.svelte.ts",
    "src/routes/**/+*.{ts,svelte}",
    "src/env.ts",
    "src/params.ts",
    "scripts/*.mts",
    "tests/**/*.test.ts",
    "tests/_kit/mock/runtime.ts",
    "tests/browser/**/*.spec.ts",
    "tests/tools/*.mts"
  ],
  "project": [
    "src/**/*.{ts,svelte}",
    "scripts/*.mts",
    "tests/**/*.{ts,mts}",
    "*.mts",
    "website/**/*.{ts,mts,astro}"
  ],
  "astro": {
    "config": ["website/astro.config.mts"],
    "entry": ["website/src/content.config.ts", "website/src/pages/**/*.astro"]
  },
  "ignoreDependencies": ["uno.css"]
}
