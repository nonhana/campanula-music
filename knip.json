{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "entry": [
    "src/routes/**/+*.{ts,svelte}",
    "src/env.ts",
    "src/params.ts",
    "scripts/*.mts",
    "tests/**/*.test.ts",
    "src/lib/server/mock/runtime.ts"
  ],
  "project": ["src/**/*.{ts,svelte}", "scripts/*.mts", "tests/**/*.ts", "*.mts"],
  "ignoreDependencies": [
    "uno.css"
  ],
  "ignoreBinaries": [
    "chrome-devtools-axi"
  ]
}
