{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // SvelteKit/Vite 插件已包含 src/hooks.server.ts、vite.config.ts；#lib/* 可从 package.json imports 正常解析。
  "entry": [
    "src/routes/**/+*.{ts,svelte}",
    // SvelteKit 的 src/env.ts 入口：defineEnvVars 声明 COOKIE_SECRET / NETEASE_REAL_IP，由 Kit 加载。
    "src/env.ts",
    // SvelteKit 的 files.params 入口：路由的 [id=neteaseId] 靠这里定义的匹配器，构建时由 Kit 加载。
    "src/params.ts",
    "scripts/*.mts",
    // 测试的真实服务端经 Vite 加载；mock 的 runtime 由 dev:mock 的 vite-plugin 动态导入（vite-plugin 经 vite.config.ts 可达）。
    "tests/**/*.test.ts",
    "src/lib/server/mock/runtime.ts"
  ],
  "project": ["src/**/*.{ts,svelte}", "scripts/*.mts", "tests/**/*.ts", "*.{js,ts}"],
  "ignoreDependencies": [
    // pnpm check 的 svelte-check --tsgo 动态解析此 npm 别名（TypeScript 7 原生编译器）。
    "@typescript/native",
    // UnoCSS 的 Vite 插件提供的虚拟 CSS 模块，不是 npm 包。
    "uno.css"
  ],
  "ignoreBinaries": [
    // scripts/browser 调用作者机器上独立安装的浏览器 CLI，不是应用依赖。
    "chrome-devtools-axi"
  ]
}
