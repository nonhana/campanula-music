{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "paths": {
      "#lib/*": ["./src/lib/*"]
    },
    "strict": true,
    "sourceMap": true
  },
  "include": [
    "src",
    "tests",
    "scripts",
    "eslint.config.mts",
    "uno.config.mts",
    "uno.palette.mts",
    "vite.config.mts",
    "website/demo"
  ],
  "exclude": [
    "src/service-worker",
    "website/demo/.kit",
    "website/demo/node_modules",
    "website/demo/.svelte-check"
  ]
}
