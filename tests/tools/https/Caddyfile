{
	admin off
	auto_https off
}

https://local.campanula.test:{$CAMPANULA_HTTPS_PORT:443} {
	bind 127.0.0.1
	tls {$CAMPANULA_TLS_CERT} {$CAMPANULA_TLS_KEY}
	reverse_proxy {$CAMPANULA_PRODUCT_UPSTREAM:localhost:5173}
}

https://mock.campanula.test:{$CAMPANULA_HTTPS_PORT:443} {
	bind 127.0.0.1
	tls {$CAMPANULA_TLS_CERT} {$CAMPANULA_TLS_KEY}
	reverse_proxy {$CAMPANULA_MOCK_UPSTREAM:127.0.0.1:5174}
}

https://:{$CAMPANULA_HTTPS_PORT:443} {
	bind 127.0.0.1
	tls {$CAMPANULA_TLS_CERT} {$CAMPANULA_TLS_KEY}
	respond "请改用 local.campanula.test 或 mock.campanula.test" 421
}
