---
import { ChevronRight, Cloud, Server } from '@lucide/svelte';
import { getCollection } from 'astro:content';

import { settingsLink } from '../../../../src/lib/components/ui/control-styles.ts';

const docs = new Map(
  (await getCollection('docs')).map((entry) => [entry.id, entry.data]),
);

const descriptionOf = (id: string) => {
  const description = docs.get(id)?.description;
  if (!description) throw new Error(`文档缺少 description：${id}`);
  return description.replace(/。$/, '');
};

const itemLink =
  'min-h-11 inline-flex items-center rounded-md px-1 text-label text-primary-900 font-500 hover:(text-primary-950 underline underline-offset-4)';
---

<section class="mt-8" aria-labelledby="about-heading">
  <h2 id="about-heading" class="px-1 text-title-sm font-600">
    认识 Campanula
  </h2>
  <ul class="grid m-0 mt-2 list-none gap-2.5 p-0">
    <li class="flex flex-col items-start">
      <a id="features-guide" class={itemLink} href="/about/features/">
        功能与边界
      </a>
      <span class="px-1 text-caption text-neutral-600">
        {descriptionOf('about/features')}
      </span>
    </li>
    <li class="flex flex-col items-start">
      <a id="privacy-guide" class={itemLink} href="/about/privacy-and-data/">
        账号安全与数据归属
      </a>
      <span class="px-1 text-caption text-neutral-600">
        {descriptionOf('about/privacy-and-data')}
      </span>
    </li>
    <li class="flex flex-col items-start">
      <a id="design-guide" class={itemLink} href="/about/design/">
        设计理念
      </a>
      <span class="px-1 text-caption text-neutral-600">
        {descriptionOf('about/design')}
      </span>
    </li>
  </ul>
</section>

<section class="mt-8" aria-labelledby="deploy-heading">
  <h2 id="deploy-heading" class="px-1 text-title-sm font-600">
    部署与运维
  </h2>
  <div class="grid mt-3 gap-3">
    <a
      id="deploy-vercel"
      class:list={[settingsLink, 'min-h-22 lt-md:px-4']}
      href="/guide/vercel/"
    >
      <Cloud size={20} class="flex-none text-primary-900" aria-hidden="true" />
      <span class="min-w-0 flex-1">
        <span class="block text-body text-neutral-900 font-500">
          部署到 Vercel
        </span>
        <span class="mt-1 block text-caption text-neutral-600">
          {descriptionOf('guide/vercel')}
        </span>
      </span>
      <ChevronRight
        size={18}
        class="flex-none text-neutral-500"
        aria-hidden="true"
      />
    </a>
    <a
      id="deploy-server"
      class:list={[settingsLink, 'min-h-22 lt-md:px-4']}
      href="/guide/server/"
    >
      <Server size={20} class="flex-none text-neutral-700" aria-hidden="true" />
      <span class="min-w-0 flex-1">
        <span class="block text-body text-neutral-900 font-500">
          部署到自建服务器
        </span>
        <span class="mt-1 block text-caption text-neutral-600">
          {descriptionOf('guide/server')}
        </span>
      </span>
      <ChevronRight
        size={18}
        class="flex-none text-neutral-500"
        aria-hidden="true"
      />
    </a>
  </div>
  <ul class="grid m-0 mt-3 list-none gap-2.5 p-0">
    <li class="flex flex-col items-start">
      <a id="deploy-docker" class={itemLink} href="/guide/docker/">
        Docker 部署
      </a>
      <span class="px-1 text-caption text-neutral-600">
        {descriptionOf('guide/docker')}
      </span>
    </li>
    <li class="flex flex-col items-start">
      <a id="deploy-node" class={itemLink} href="/guide/node/">
        Node.js 部署
      </a>
      <span class="px-1 text-caption text-neutral-600">
        {descriptionOf('guide/node')}
      </span>
    </li>
    <li class="flex flex-col items-start">
      <a id="upgrade-guide" class={itemLink} href="/guide/upgrade/">
        升级与回退
      </a>
      <span class="px-1 text-caption text-neutral-600">
        {descriptionOf('guide/upgrade')}
      </span>
    </li>
  </ul>
</section>

<section class="mt-8" aria-labelledby="listen-heading">
  <h2 id="listen-heading" class="px-1 text-title-sm font-600">
    日常使用
  </h2>
  <ul class="grid m-0 mt-2 list-none gap-2.5 p-0">
    <li class="flex flex-col items-start">
      <a id="listen-guide" class={itemLink} href="/guide/listen/">
        安装与离线播放
      </a>
      <span class="px-1 text-caption text-neutral-600">
        {descriptionOf('guide/listen')}
      </span>
    </li>
  </ul>
</section>

<section class="mt-8" aria-labelledby="develop-heading">
  <h2 id="develop-heading" class="px-1 text-title-sm font-600">
    开发与架构
  </h2>
  <ul class="grid m-0 mt-2 list-none gap-2.5 p-0">
    <li class="flex flex-col items-start">
      <a id="development-guide" class={itemLink} href="/development/">
        本地开发
      </a>
      <span class="px-1 text-caption text-neutral-600">
        {descriptionOf('development')}
      </span>
    </li>
    <li class="flex flex-col items-start">
      <a
        id="architecture-guide"
        class={itemLink}
        href="/development/architecture/"
      >
        架构与实现概览
      </a>
      <span class="px-1 text-caption text-neutral-600">
        {descriptionOf('development/architecture')}
      </span>
    </li>
  </ul>
</section>
