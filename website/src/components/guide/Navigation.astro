<link
  rel="expect"
  blocking="render"
  href={Astro.url.pathname === '/' ? '#home-copy' : '#main'}
/>
<style is:inline>
  @view-transition {
    navigation: auto;
  }
</style>
<script is:inline>
  (() => {
    const focusKey = () =>
      `campanula-reading:${window.navigation?.currentEntry?.key ?? location.href}`;
    const setDirection = (transition, activation) => {
      if (!transition || !activation?.from?.url || !activation.entry.url)
        return;
      const from = new URL(activation.from.url);
      const to = new URL(activation.entry.url);
      const depth = (path) => path.split('/').filter(Boolean).length;
      const type = matchMedia('(prefers-reduced-motion: reduce)').matches
        ? 'fade'
        : depth(to.pathname) < depth(from.pathname)
          ? 'down'
          : 'up';
      transition.types.add(type);
    };
    addEventListener('pageswap', (event) =>
      setDirection(event.viewTransition, event.activation),
    );
    addEventListener('pagereveal', (event) =>
      setDirection(event.viewTransition, window.navigation?.activation),
    );
    addEventListener('pagehide', () => {
      try {
        sessionStorage.setItem(focusKey(), document.activeElement?.id ?? '');
      } catch {}
    });
    addEventListener('pageshow', (event) => {
      const back =
        event.persisted ||
        performance.getEntriesByType('navigation')[0]?.type === 'back_forward';
      if (!back) return;
      try {
        const id = sessionStorage.getItem(focusKey());
        if (id) document.getElementById(id)?.focus({ preventScroll: true });
      } catch {}
    });
    document.addEventListener('click', (event) => {
      if (
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      )
        return;
      const link = event.target.closest('a');
      if (!link || !['reading-back', 'footer-back'].includes(link.id)) return;
      const previous = window.navigation
        ?.entries()
        .slice(0, window.navigation.currentEntry.index)
        .findLast(
          (entry) =>
            entry.url &&
            new URL(entry.url).pathname === new URL(link.href).pathname,
        );
      if (previous) {
        event.preventDefault();
        window.navigation.traverseTo(previous.key);
      }
    });
  })();
</script>
<style is:global>
  [data-brand] svg {
    view-transition-name: website-logo;
  }
  [data-brand] [data-brand-name] {
    view-transition-name: website-name;
    color: theme('colors.primary.950');
    line-height: 1;
    letter-spacing: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .source-link > svg {
      view-transition-name: website-github;
    }
  }
  ::view-transition-group(website-logo),
  ::view-transition-group(website-name),
  ::view-transition-group(website-github) {
    z-index: 2;
    animation-duration: var(--move-focal-bar);
    animation-timing-function: var(--ease-out-soft);
  }
  ::view-transition-old(website-logo),
  ::view-transition-old(website-name),
  ::view-transition-old(website-github) {
    display: none;
  }
  ::view-transition-new(website-logo),
  ::view-transition-new(website-name),
  ::view-transition-new(website-github) {
    animation: none;
    width: 100%;
    height: 100%;
    object-fit: fill;
    object-position: left center;
  }
  html:active-view-transition-type(fade) [data-brand] svg,
  html:active-view-transition-type(fade) [data-brand-name] {
    view-transition-name: none;
  }
  html:active-view-transition-type(fade) .site-header {
    view-transition-class: crossfade;
  }
</style>
