---
import { Icon } from '@astrojs/starlight/components';

interface Props {
  id?: string;
}
---

<a
  id={Astro.props.id}
  href="https://github.com/nonhana/campanula-music"
  class="source-link min-h-11 inline-flex items-center gap-2 rounded-md px-3 text-label text-neutral-700 font-500 hover:(text-primary-950 underline underline-offset-4)"
  aria-label="在 GitHub 查看 Campanula 源码"
  title="在 GitHub 查看源码"
  target="_blank"
  rel="external noopener"
>
  <Icon name="github" size="20px" />
</a>
