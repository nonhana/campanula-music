---
import { ArrowUpRight } from '@lucide/svelte';
import Choices from './Choices.astro';
const choice = Astro.locals.starlightRoute.entry.id === 'guide';
---

{choice ? (
  <Choices />
) : (
  <article class="reading-content">
    <svg width="0" height="0" aria-hidden="true" class="absolute">
      <defs>
        <ArrowUpRight id="guide-external-arrow" size={24} />
      </defs>
    </svg>
    <slot />
  </article>
)}
