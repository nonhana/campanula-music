{
  "name": "campanula-music",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo '' && simple-git-hooks",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --watch",
    "lint": "eslint . && tsx scripts/check-design-tokens.mts",
    "lint:fix": "eslint . --fix",
    "test": "vitest run"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@eslint/config-helpers": "catalog:",
    "@fontsource-variable/noto-sans": "catalog:",
    "@fontsource-variable/noto-sans-jp": "catalog:",
    "@fontsource-variable/noto-sans-sc": "catalog:",
    "@fontsource-variable/noto-sans-tc": "catalog:",
    "@lucide/svelte": "catalog:",
    "@sinonjs/fake-timers": "catalog:",
    "@sveltejs/adapter-node": "catalog:",
    "@sveltejs/adapter-vercel": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@types/node": "catalog:",
    "@typescript-eslint/types": "catalog:",
    "@typescript/native": "catalog:",
    "@unocss/eslint-plugin": "catalog:",
    "@unocss/preset-rem-to-px": "catalog:",
    "@unocss/reset": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-svelte": "catalog:",
    "fake-indexeddb": "catalog:",
    "globals": "catalog:",
    "hana-music-api": "catalog:",
    "lint-staged": "catalog:",
    "simple-git-hooks": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "tough-cookie": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "pre-push": "pnpm check && pnpm test"
  },
  "lint-staged": {
    "*": "eslint --fix --no-warn-ignored",
    "src/**/*.{svelte,ts}": "tsx scripts/check-design-tokens.mts",
    "tests/fixtures/**/*.{json,gz}": "tsx scripts/fixture-identity.mts"
  }
}
