{
  "name": "campanula-music",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "smoke": "node scripts/smoke-ncm.ts"
  },
  "dependencies": {
    "@lucide/svelte": "catalog:",
    "hana-music-api": "catalog:",
    "throttle-debounce": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@eslint/compat": "catalog:",
    "@neoconfetti/svelte": "catalog:",
    "@sveltejs/adapter-node": "catalog:",
    "@sveltejs/enhanced-img": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@testing-library/svelte": "catalog:",
    "@types/node": "catalog:",
    "@types/throttle-debounce": "catalog:",
    "@typescript-eslint/types": "catalog:",
    "@unocss/eslint-plugin": "catalog:",
    "@unocss/preset-rem-to-px": "catalog:",
    "@unocss/reset": "catalog:",
    "@unocss/svelte-scoped": "catalog:",
    "autoprefixer": "catalog:",
    "csstype": "catalog:",
    "dayjs": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-svelte": "catalog:",
    "globals": "catalog:",
    "jsdom": "catalog:",
    "sass": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "unocss-preset-scrollbar": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
