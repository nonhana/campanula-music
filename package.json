{
  "name": "campanula-music",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "tsx tests/tools/dev-product.mts",
    "dev:mock": "tsx tests/tools/dev-mock.mts",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo '' && simple-git-hooks",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo && tsc -p src/service-worker/tsconfig.json --noEmit",
    "check:endpoints": "tsx tests/tools/check-endpoints.mts",
    "check:mock-isolation": "tsx tests/tools/check-mock-isolation.mts",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --watch",
    "fixtures:index": "tsx tests/tools/fixture-index.mts",
    "fixtures:index:check": "tsx tests/tools/fixture-index.mts --check",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "eslint --cache && tsx scripts/check-design-tokens.mts",
    "lint:fix": "eslint --fix",
    "smoke:mock": "tsx scripts/mock-smoke.mts",
    "test": "tsx tests/tools/run.mts all",
    "knip": "knip",
    "test:unit": "tsx tests/tools/run.mts unit",
    "test:behavior": "tsx tests/tools/run.mts behavior",
    "test:contract": "tsx tests/tools/run.mts contract",
    "test:coverage": "tsx tests/tools/run.mts all --coverage",
    "test:coverage:calibrate": "CAMPANULA_COVERAGE_CALIBRATE=1 tsx tests/tools/run.mts behavior tests/behavior/session.test.ts -t 未登录：没有当前账号 --coverage",
    "test:environment": "tsx tests/tools/run.mts delivery",
    "test:environment:https": "tsx tests/tools/https-check.mts && tsx tests/tools/https-check.mts --interrupt-check",
    "dev:http": "tsx tests/tools/dev-product.mts --http",
    "dev:mock:http": "tsx tests/tools/dev-mock.mts --http",
    "dev:setup": "tsx tests/tools/https-prepare.mts",
    "dev:proxy": "tsx tests/tools/dev-proxy.mts"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:lint",
    "@fontsource-variable/noto-sans": "catalog:ui",
    "@fontsource-variable/noto-sans-jp": "catalog:ui",
    "@fontsource-variable/noto-sans-sc": "catalog:ui",
    "@fontsource-variable/noto-sans-tc": "catalog:ui",
    "@lucide/svelte": "catalog:ui",
    "@playwright/cli": "catalog:test",
    "@sinonjs/fake-timers": "catalog:test",
    "@sveltejs/adapter-node": "catalog:build",
    "@sveltejs/adapter-vercel": "catalog:build",
    "@sveltejs/kit": "catalog:build",
    "@sveltejs/vite-plugin-svelte": "catalog:build",
    "@types/node": "catalog:typescript",
    "@types/ws": "catalog:typescript",
    "@typescript/native": "catalog:typescript",
    "@unocss/eslint-plugin": "catalog:lint",
    "@unocss/preset-rem-to-px": "catalog:ui",
    "@unocss/reset": "catalog:ui",
    "@vitest/coverage-v8": "catalog:test",
    "@vitest/istanbul-lib-coverage": "catalog:test",
    "ast-v8-to-istanbul": "catalog:test",
    "axe-core": "catalog:test",
    "browser-id3-writer": "catalog:music",
    "chrome-devtools-axi": "catalog:test",
    "chrome-devtools-mcp": "catalog:test",
    "eslint": "catalog:lint",
    "eslint-plugin-svelte": "catalog:lint",
    "fake-indexeddb": "catalog:test",
    "hana-music-api": "catalog:music",
    "knip": "catalog:lint",
    "lint-staged": "catalog:git",
    "music-metadata": "catalog:music",
    "oxfmt": "catalog:lint",
    "simple-git-hooks": "catalog:git",
    "svelte": "catalog:build",
    "svelte-check": "catalog:typescript",
    "tough-cookie": "catalog:music",
    "tsx": "catalog:typescript",
    "typescript": "catalog:typescript",
    "unocss": "catalog:ui",
    "vite": "catalog:build",
    "vitest": "catalog:test",
    "ws": "catalog:test"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix --no-warn-ignored",
    "src/**/*.{svelte,ts}": "tsx scripts/check-design-tokens.mts",
    "tests/fixtures/**/*.{json,gz}": "tsx tests/tools/fixture-identity.mts"
  }
}
