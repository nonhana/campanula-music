{
  "name": "campanula-music",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:mock": "CAMPANULA_MOCK=1 COOKIE_SECRET=campanula-mock-development-secret-0123456789abcdef LOGIN_COOKIE_NAME=campanula_login_mock vite dev --port 5174 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo '' && simple-git-hooks",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo && tsc -p src/service-worker/tsconfig.json --noEmit",
    "check:endpoints": "tsx scripts/check-endpoints.mts",
    "check:mock-isolation": "tsx scripts/check-mock-isolation.mts",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --watch",
    "fixtures:index": "tsx scripts/fixture-index.mts",
    "fixtures:index:check": "tsx scripts/fixture-index.mts --check",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "eslint --cache && tsx scripts/check-design-tokens.mts",
    "lint:fix": "eslint --fix",
    "smoke:mock": "tsx scripts/mock-smoke.mts",
    "test": "vitest run",
    "knip": "knip"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:lint",
    "@fontsource-variable/noto-sans": "catalog:ui",
    "@fontsource-variable/noto-sans-jp": "catalog:ui",
    "@fontsource-variable/noto-sans-sc": "catalog:ui",
    "@fontsource-variable/noto-sans-tc": "catalog:ui",
    "@lucide/svelte": "catalog:ui",
    "@sinonjs/fake-timers": "catalog:test",
    "@sveltejs/adapter-node": "catalog:build",
    "@sveltejs/adapter-vercel": "catalog:build",
    "@sveltejs/kit": "catalog:build",
    "@sveltejs/vite-plugin-svelte": "catalog:build",
    "@types/node": "catalog:typescript",
    "@typescript/native": "catalog:typescript",
    "@unocss/eslint-plugin": "catalog:lint",
    "@unocss/preset-rem-to-px": "catalog:ui",
    "@unocss/reset": "catalog:ui",
    "browser-id3-writer": "catalog:music",
    "eslint": "catalog:lint",
    "eslint-plugin-svelte": "catalog:lint",
    "fake-indexeddb": "catalog:test",
    "hana-music-api": "catalog:music",
    "knip": "catalog:lint",
    "lint-staged": "catalog:git",
    "music-metadata": "catalog:music",
    "oxfmt": "catalog:lint",
    "simple-git-hooks": "catalog:git",
    "svelte": "catalog:build",
    "svelte-check": "catalog:typescript",
    "tough-cookie": "catalog:music",
    "tsx": "catalog:typescript",
    "typescript": "catalog:typescript",
    "unocss": "catalog:ui",
    "vite": "catalog:build",
    "vitest": "catalog:test"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix --no-warn-ignored",
    "src/**/*.{svelte,ts}": "tsx scripts/check-design-tokens.mts",
    "tests/fixtures/**/*.{json,gz}": "tsx scripts/fixture-identity.mts"
  }
}
