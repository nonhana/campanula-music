{
  "name": "campanula-music",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo '' && simple-git-hooks",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@eslint/config-helpers": "catalog:",
    "@sveltejs/adapter-node": "catalog:",
    "@sveltejs/adapter-vercel": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@types/node": "catalog:",
    "@typescript-eslint/types": "catalog:",
    "@unocss/eslint-plugin": "catalog:",
    "@unocss/preset-rem-to-px": "catalog:",
    "@unocss/reset": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-svelte": "catalog:",
    "globals": "catalog:",
    "lint-staged": "catalog:",
    "simple-git-hooks": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "unocss-preset-scrollbar": "catalog:",
    "vite": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix --no-warn-ignored"
  }
}
